 "commit": {
  "author": "Azzinoth",
  "date": "2026-11-12T02:20:27Z",
  "message": "Updated Focal Engine submodule to the latest version; FEEditorPreviewManager now uses AABB returned by FEAABB::Transform to center mesh, game model and point cloud in preview, previously result was ignored, so objects with geometry far from their origin were out of frame; FEEditorPreviewManager::CreateMaterialPreview now updates previews of game models that use material once, previously it did it twice; FEEditorPreviewManager::CreateMeshPreview no longer loops through all game models, that loop compared materials instead of meshes and never updated anything; Removed FEEditorPreviewManager::CheckAndUpdateIfNeededGameModelPreview; FEEditorPreviewManager::ReCreateAll now skips game models that already got preview from their material; FEEditorPreviewManager::GetMaterialPreview no longer updates game model and prefab previews second time after CreateMaterialPreview; FEEditorPreviewManager::GetGameModelPreview no longer updates previews of all game models when material of game model is dirty, CreateMaterialPreview already updates game models that use that material.",
  "url": "https://github.com/Azzinoth/FocalEngineEditor/commit/9a722bce2e3bfdc14a97f1e32f39dea647a1edcb"
 },
